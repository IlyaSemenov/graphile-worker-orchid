{
  "name": "graphile-worker-orchid",
  "type": "module",
  "version": "2.4.0",
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "description": "Use graphile-worker with orchid-orm",
  "author": "Ilya Semenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaSemenov/graphile-worker-orchid"
  },
  "imports": {
    "#lib": "./src/index.ts",
    "#lib/testing": "./src/testing.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "files": [
    "!src/**/*.test.*",
    "dist",
    "src"
  ],
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "lint": "eslint --fix .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "graphile-worker": ">=0.17.2",
    "orchid-orm": ">=1.72.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^2.27.10",
    "@ilyasemenov/eslint-config": "^1.4.2",
    "eslint": "^9.36.0",
    "graphile-worker": "^0.17.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "orchid-orm": "~1.72.9",
    "postgres": "^3.4.9",
    "publint": "^0.3.25",
    "tsconfig-vite-node": "^1.1.2",
    "tsdown": "^0.18.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
